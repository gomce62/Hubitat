def installed() {
    log.info "Installed with settings: ${settings}"
    initialize()
}

def updated() {
    log.info "Updated with settings: ${settings}"
    unsubscribe()
    initialize()
}

def initialize() {
    log.debug "Initializing Ring Connect"
    // Add device creation logic here if needed
}

def apiRequest(endpoint, method = "GET", body = null, callback = "defaultHandler") {
    def params = [
        uri: "https://api.ring.com${endpoint}",
        headers: ["Content-Type": "application/json"],
        body: body ? groovy.json.JsonOutput.toJson(body) : null
    ]

    try {
        switch (method.toUpperCase()) {
            case "POST":
                asynchttpPost(callback, params)
                break
            case "PUT":
                asynchttpPut(callback, params)
                break
            case "DELETE":
                asynchttpDelete(callback, params)
                break
            default:
                asynchttpGet(callback, params)
        }
    } catch (e) {
        log.error "API request failed: ${e.message}"
    }
}

def defaultHandler(response, data) {
    if (response.status == 200) {
        log.debug "API response: ${response.data}"
    } else {
        log.warn "API call failed: ${response.status}"
    }
}
