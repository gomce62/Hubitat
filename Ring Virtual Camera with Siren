metadata {
  definition(name: "Ring Virtual Camera with Light and Siren", namespace: "ring-hubitat-codahq", author: "Ben Rimmasch, Caleb Morse") {
    capability "Actuator"
    capability "Battery"
    capability "MotionSensor"
    capability "Polling"
    capability "PushableButton"
    capability "Refresh"
    capability "Sensor"
    capability "Switch"

    attribute "sirenStatus", "string"
    attribute "lastDing", "string"
    attribute "motionDetectionStatus", "string"
    attribute "motionAlertsStatus", "string"
    attribute "battery2", "number"
    attribute "firmware", "string"
    attribute "rssi", "number"
    attribute "wifi", "string"

    command "getDings"
    command "sirenOn"
    command "sirenOff"
    command "enableMotionDetection"
    command "disableMotionDetection"
    command "enableMotionAlerts"
    command "disableMotionAlerts"
  }

  preferences {
    input name: "snapshotPolling", type: "bool", title: "Enable polling for thumbnail snapshots", defaultValue: false
    input name: "lightPolling", type: "bool", title: "Enable polling for light status", defaultValue: false
    input name: "lightInterval", type: "number", range: 10..600, title: "Seconds between light polls", defaultValue: 15
    input name: "descriptionTextEnable", type: "bool", title: "Enable descriptionText logging", defaultValue: false
    input name: "logEnable", type: "bool", title: "Enable debug logging", defaultValue: false
    input name: "traceLogEnable", type: "bool", title: "Enable trace logging", defaultValue: false
  }
}

void logInfo(msg) { if (descriptionTextEnable) log.info msg }
void logDebug(msg) { if (logEnable) log.debug msg }
void logTrace(msg) { if (traceLogEnable) log.trace msg }
void logWarn(msg) { log.warn msg }

def installed() {
  sendEvent(name: "numberOfButtons", value: 2)
  sendEvent(name: "sirenStatus", value: "off")
  sendEvent(name: "lastDing", value: "none")
  sendEvent(name: "motionDetectionStatus", value: "unknown")
  sendEvent(name: "motionAlertsStatus", value: "unknown")
}

def updated() {
  setupPolling()
  parent.snapshotOption(device.deviceNetworkId, snapshotPolling)
}

def setupPolling() {
  unschedule()
  if (lightPolling) pollLight()
}

def pollLight() {
  logTrace "pollLight()"
  refresh()
  if (lightPolling) runIn(lightInterval, pollLight)
}

def parse(String description) { logDebug "description: ${description}" }
def poll() { refresh() }

def refresh() {
  logDebug "refresh()"
  parent.apiRequestDeviceRefresh(device.deviceNetworkId)
  parent.apiRequestDeviceHealth(device.deviceNetworkId, "doorbots")
}

def getDings() {
  logDebug "getDings()"
  def dings = parent.apiRequestDings()
  if (dings) {
    def dingSummary = dings.collect { "${it.kind} at ${it.created_at}" }.join(", ")
    sendEvent(name: "lastDing", value: dingSummary ?: "No recent dings")
  } else {
    sendEvent(name: "lastDing", value: "No recent dings")
  }
}

def sirenOn() {
  parent.apiRequestDeviceSet(device.deviceNetworkId, "doorbots", "siren_on")
  sendEvent(name: "sirenStatus", value: "on")
}

def sirenOff() {
  parent.apiRequestDeviceSet(device.deviceNetworkId, "doorbots", "siren_off")
  sendEvent(name: "sirenStatus", value: "off")
}

def enableMotionDetection() {
  parent.apiRequestDeviceSet(device.deviceNetworkId, "doorbots", "motion_detection_enabled", true)
  sendEvent(name: "motionDetectionStatus", value: "enabled")
  logInfo "Motion detection enabled"
}

def disableMotionDetection() {
  parent.apiRequestDeviceSet(device.deviceNetworkId, "doorbots", "motion_detection_enabled", false)
  sendEvent(name: "motionDetectionStatus", value: "disabled")
  logInfo "Motion detection disabled"
}

def enableMotionAlerts() {
  parent.apiRequestDeviceSet(device.deviceNetworkId, "doorbots", "motion_alerts_enabled", true)
  sendEvent(name: "motionAlertsStatus", value: "enabled")
  logInfo "Motion alerts enabled"
}

def disableMotionAlerts() {
  parent.apiRequestDeviceSet(device.deviceNetworkId, "doorbots", "motion_alerts_enabled", false)
  sendEvent(name: "motionAlertsStatus", value: "disabled")
  logInfo "Motion alerts disabled"
}

def push(buttonNumber) {
  switch (buttonNumber) {
    case 1: sirenOn(); break
    case 2: sirenOff(); break
    default: logWarn "Unhandled button number: $buttonNumber"
  }
}

def on() {
  parent.apiRequestDeviceSet(device.deviceNetworkId, "doorbots", "floodlight_light_on")
  sendEvent(name: "switch", value: "on")
}

def off() {
  parent.apiRequestDeviceSet(device.deviceNetworkId, "doorbots", "floodlight_light_off")
  sendEvent(name: "switch", value: "off")
}

def handleDeviceSet(final String action, final Map msg, final Map query) {
  switch (action) {
    case "floodlight_light_on": checkChanged("switch", "on"); break
    case "floodlight_light_off": checkChanged("switch", "off"); break
    case "siren_on":
      checkChanged("sirenStatus", "on")
      runIn(msg.seconds_remaining + 1, refresh); break
    case "siren_off":
      checkChanged("sirenStatus", "off"); break
    default: log.error "Unsupported action: ${action}"
  }
}

def handleMotion(final Map msg) {
  if (msg.motion == true) {
    checkChanged("motion", "active")
    runIn(60, motionOff)
  } else if (msg.motion == false) {
    checkChanged("motion", "inactive")
    unschedule(motionOff)
  } else {
    log.error("Unsupported motion msg: ${msg}")
  }
}

def motionOff() { checkChanged("motion", "inactive") }

def handleHealth(final Map msg) {
  if (msg.device_health?.wifi_name) checkChanged("wifi", msg.device_health.wifi_name)
}

def handleRefresh(final Map msg) {
  logDebug "Raw refresh msg: ${msg}"

  if (!discardBatteryLevel) {
    if (msg.battery_life) checkChanged("battery", msg.battery_life, "%")
    if (msg.battery_life_2) checkChanged("battery2", msg.battery_life_2, "%")
  }

  if (msg.led_status instanceof String && ["on", "off"].contains(msg.led_status)) {
    checkChanged("switch", msg.led_status)
  } else {
    logWarn "Unexpected led_status format: ${msg.led_status}"
  }

  if (msg.siren_status?.seconds_remaining != null) {
    def secondsRemaining = msg.siren_status.seconds_remaining
    checkChanged("sirenStatus", secondsRemaining > 0 ? "on" : "off")
    if (secondsRemaining > 0) runIn(secondsRemaining + 1, refresh)
  }

  if (msg.motion_detection_enabled != null) {
    checkChanged("motionDetectionStatus", msg.motion_detection_enabled ? "enabled" : "disabled")
  }

  if (msg.motion_alerts_enabled != null) {
    checkChanged("motionAlertsStatus", msg.motion_alerts_enabled ? "enabled" : "disabled")
  }

  if (msg.health) {
    if (msg.health.firmware_version) checkChanged("firmware", msg.health.firmware_version)
    if (msg.health.rssi) checkChanged("rssi", msg.health.rssi)
  }
}

def runCleanup() {
  state.remove("lastActivity")
  device.removeDataValue("firmware")
  device.removeDataValue("device_id")
}

boolean checkChanged(String attribute, def newValue, String unit = null, String type = null) {
  boolean changed = device.currentValue(attribute) != newValue
  if (changed) logInfo "${attribute.capitalize()} for ${device.label} is ${newValue}"
  sendEvent(name: attribute, value: newValue, unit: unit, type: type)
  return changed
}
