import groovy.json.*
import java.text.SimpleDateFormat
import java.util.TimeZone

metadata {
    definition(
        name: "Emporia Vue Utility Connect Driver",
        namespace: "gomce62",
        author: "Chris Feduniw",
        importUrl:"https://raw.githubusercontent.com/gomce62/Hubitat/refs/heads/Drivers/Emporia_Vue_Utility_Connect_Driver",
    ){
        capability "Actuator"
        capability "Refresh"
        capability "PowerSource"
        capability "PowerMeter"
        capability "EnergyMeter"

        command "authToken", [[name: "Update Authtoken*", type: "STRING"]]
        command "getDeviceGid"
        command "generateToken"
        command "refreshToken"

        attribute "tokenExpiry", "string"
        attribute "lastUpdate", "string"
        attribute "KilowattHours", "number"
        attribute "Dollars", "number"
        attribute "AmpHours", "number"
        attribute "Trees", "number"
        attribute "GallonsOfGas", "number"
        attribute "MilesDriven", "number"
        attribute "Carbon", "number"
        attribute "Scale", "string"
    }

    preferences {
        input name: "logEnable", type: "bool", title: "Enable Info logging", defaultValue: true
        input name: "debugLog", type: "bool", title: "Enable Debug logging", defaultValue: true
        input name: "jsonState", type: "bool", title: "Show JSON state", defaultValue: true
        input name: "email", type: "string", title: "Emporia Email", required: true
        input name: "password", type: "password", title: "Emporia Password", required: true

        input("scale", "enum", title: "Scale", options: [
            ["1S": "1 Second"],
            ["1MIN": "1 Minute"],
            ["1H": "1 Hour"],
            ["1D": "1 Day"],
            ["1W": "1 Week"],
            ["1Mon": "1 Month"],
            ["1Y": "1 Year"]
        ], required: true, defaultValue: "1H")

        input("refresh_interval", "enum", title: "How often to refresh the Emporia data", options: [
            0: "Do NOT update",
            1: "1 Minute",
            5: "5 Minutes",
            10: "10 Minutes",
            15: "15 Minutes",
            20: "20 Minutes",
            30: "30 Minutes",
            45: "45 Minutes",
            60: "1 Hour"
        ], required: true, defaultValue: "60")
    }
}

def version(){ return "2.0.2-fixed" }

def installed(){
    if(logEnable) log.info "Driver installed"
    state.version = version()
    state.deviceGID = []
    state.deviceNames = []
    scheduleTokenRefresh()
}

def uninstalled() {
    unschedule()
    if(logEnable) log.info "Driver uninstalled"
}

def updated(){
    if (logEnable) log.info "Settings updated"

    if (settings.refresh_interval != "0") {
        if (settings.refresh_interval == "60") {
            schedule("7 0 * ? * * *", refresh, [overwrite: true])
        } else {
            schedule("7 */${settings.refresh_interval} * ? * *", refresh, [overwrite: true])
        }
    } else {
        unschedule(refresh)
    }

    sendEvent(name: "Scale", value: scale)

    if (!jsonState) state.remove("JSON")

    scheduleTokenRefresh()
}

/* ---------------------------------------------------------
   FIXED TOKEN REFRESH SYSTEM
--------------------------------------------------------- */

def scheduleTokenRefresh() {
    if (!state.tokenExpiry) return

    unschedule("refreshToken")

    long msUntilRefresh = state.tokenExpiry - now() - 300000  // 5 minutes early

    if (msUntilRefresh < 0) {
        log.warn "Token expired or near expiry — refreshing immediately"
        runIn(2, "refreshToken")
        return
    }

    int seconds = (int)(msUntilRefresh / 1000)

    log.info "Scheduling token refresh in ${seconds} seconds"
    runIn(seconds, "refreshToken")
}

def generateToken() {
    def authEndpoint = "https://cognito-idp.us-east-2.amazonaws.com/"
    def headers = [
        "Content-Type": "application/x-amz-json-1.1",
        "X-Amz-Target": "AWSCognitoIdentityProviderService.InitiateAuth"
    ]
    def body = JsonOutput.toJson([
        AuthFlow: "USER_PASSWORD_AUTH",
        ClientId: "4qte47jbstod8apnfic0bunmrq",
        AuthParameters: [
            USERNAME: settings.email,
            PASSWORD: settings.password
        ]
    ])

    try {
        httpPost([uri: authEndpoint, headers: headers, body: body, requestContentType: "application/json"]) { resp ->
            if (resp.status == 200) {
                def responseData = (resp.data instanceof java.io.InputStream) ? 
                    new JsonSlurper().parse(resp.data) : resp.data

                if (responseData?.AuthenticationResult) {
                    def ar = responseData.AuthenticationResult

                    state.idToken = ar.IdToken
                    state.accessToken = ar.AccessToken
                    state.refreshToken = ar.RefreshToken ?: state.refreshToken
                    state.tokenExpiry = now() + (ar.ExpiresIn * 1000)

                    sendEvent(name: "tokenExpiry",
                        value: new Date(state.tokenExpiry).format("yyyy-MM-dd'T'HH:mm:ss'Z'")
                    )

                    log.info "Token generated successfully"
                    scheduleTokenRefresh()
                } else {
                    log.error "AuthenticationResult missing: ${responseData}"
                }
            } else {
                log.error "Failed to generate token: HTTP ${resp.status}"
            }
        }
    } catch (e) {
        log.error "Error generating token: ${e.message}"
    }
}

def refreshToken() {
    def authEndpoint = "https://cognito-idp.us-east-2.amazonaws.com/"
    def headers = [
        "Content-Type": "application/x-amz-json-1.1",
        "X-Amz-Target": "AWSCognitoIdentityProviderService.InitiateAuth"
    ]
    def body = JsonOutput.toJson([
        AuthFlow: "REFRESH_TOKEN_AUTH",
        ClientId: "4qte47jbstod8apnfic0bunmrq",
        AuthParameters: [
            REFRESH_TOKEN: state.refreshToken
        ]
    ])

    try {
        httpPost([uri: authEndpoint, headers: headers, body: body, requestContentType: "application/json"]) { resp ->
            if (resp.status == 200) {
                def responseData = (resp.data instanceof java.io.InputStream) ? 
                    new JsonSlurper().parse(resp.data) : resp.data

                if (responseData?.AuthenticationResult) {
                    def ar = responseData.AuthenticationResult

                    state.idToken = ar.IdToken
                    state.accessToken = ar.AccessToken
                    state.tokenExpiry = now() + (ar.ExpiresIn * 1000)

                    sendEvent(name: "tokenExpiry",
                        value: new Date(state.tokenExpiry).format("yyyy-MM-dd'T'HH:mm:ss'Z'")
                    )

                    log.info "Token refreshed successfully"
                    scheduleTokenRefresh()
                } else {
                    log.error "Missing AuthenticationResult in refresh response"
                }
            } else {
                log.error "Failed to refresh token: HTTP ${resp.status}"
            }
        }
    } catch (e) {
        log.error "Error refreshing token: ${e.message}"
    }
}

/* ---------------------------------------------------------
   DEVICE + ENERGY REFRESH LOGIC
--------------------------------------------------------- */

def getDeviceGid() {
    def host = "https://api.emporiaenergy.com/"
    def command = "customers/devices"

    try {
        httpGet([uri: "${host}${command}", headers: ['authtoken': state.idToken]]) { resp ->
            def response = resp.data

            def deviceGID = []
            def deviceNames = []

            response.devices.each { dev ->
                deviceGID.add(dev.deviceGid)

                dev.channels.each { ch ->
                    if (ch.name) deviceNames.add(ch.name)
                }
            }

            state.deviceGID = deviceGID
            state.deviceNames = deviceNames

            log.info "Device GID updated: ${deviceGID}"
        }
    } catch (e) {
        log.error "Error fetching device GID: ${e.message}"
    }
}

def refresh() {
    if (!state.deviceGID) {
        log.info "Device GID not found. Please generate token and run getDeviceGid()"
        return
    }

    def Gid_string = state.deviceGID.join("+")
    def instant = new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC'))
    def host = "https://api.emporiaenergy.com/"

    ["KilowattHours", "Dollars", "AmpHours", "Trees", "GallonsOfGas", "MilesDriven", "Carbon"].each { energyUnit ->
        attemptRefresh([host: host, Gid_string: Gid_string, instant: instant, energyUnit: energyUnit, attempts: 0])
    }

    def formattedDate = new SimpleDateFormat("MM-dd-yyyy h:mm:ss a").format(new Date())
    state.lastUpdate = formattedDate
    sendEvent(name: "lastUpdate", value: formattedDate)
}

def attemptRefresh(params) {
    def command = "AppAPI?apiMethod=getDeviceListUsages&deviceGids=${params.Gid_string}&instant=${params.instant}&scale=${scale}&energyUnit=${params.energyUnit}"

    def JSON = httpGet([uri: "${params.host}${command}", headers: ['authtoken': state.idToken]]) { resp -> resp.data }

    if (jsonState) state.JSON = JsonOutput.toJson(JSON)

    def combinedTotals = 0
    def needsRetry = false

    JSON.deviceListUsages.devices.each { value ->
        value.channelUsages.each { next_value ->
            def usage = next_value.usage

            if (usage == null) {
                if (params.attempts < 6) {
                    runIn(10, attemptRefresh, [overwrite: false, data: [host: params.host, Gid_string: params.Gid_string, instant: params.instant, energyUnit: params.energyUnit, attempts: params.attempts + 1]])
                    needsRetry = true
                    return
                } else {
                    log.error "Null usage after 5 attempts on ${next_value.name}"
                    return
                }
            }

            def Wh = roundToTwoDecimalPlaces(convertToWh(usage) ?: 0)
            combinedTotals += Wh
        }
    }

    if (!needsRetry) {
        sendEvent(name: params.energyUnit, value: "${roundToTwoDecimalPlaces(combinedTotals / 1000)}")
    }
}

def roundToTwoDecimalPlaces(value) {
    return Math.round(value * 100) / 100
}

def authToken(token) {
    state.idToken = token
    state.lastTokenUpdate = new Date()
}

def convertToWh(usage) {
    if (usage == null) return null

    switch(scale) {
        case "1S":
            return Math.round(usage * 60 * 60 * 1000)
        case "1MIN":
            return Math.round(usage * 60 * 1000)
        default:
            return Math.round(usage * 1000)
    }
}
